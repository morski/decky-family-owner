{
  "name": "decky-family-owner",
  "version": "0.1.0",
  "description": "All Steam Families owner avatars on Gaming Mode Library capsules",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "package": "pnpm typecheck && pnpm test && pnpm build && python3 scripts/package.py"
  },
  "keywords": [
    "decky",
    "steam-families",
    "steam-deck"
  ],
  "author": "Family Owner contributors",
  "license": "UNLICENSED",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@rollup/rollup-linux-x64-musl": "4.53.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/webpack": "5.28.5",
    "rollup": "4.53.3",
    "typescript": "5.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.28.0",
    "vitest": "2.1.9",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/dom": "10.4.0"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
